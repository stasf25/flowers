# CompetitorAI — пример окружения. Скопируйте в .env и впишите свои значения:
#   cp .env.example .env
# Здесь только переменные, которые реально читает код (backend/config.py)
# и docker-compose.yml.

# --- AI API (OpenAI-совместимый). Обязательно ---
PROXYAPI_KEY=your_proxy_api_key_here
# Базовый URL API (у routerai свой, у proxyapi свой — впиши свой)
PROXYAPI_BASE_URL=https://routerai.ru/api/v1

# --- Модели (опционально) ---
PROXYAPI_CHAT_MODEL=openai/gpt-6-luna-pro
PROXYAPI_VL_MODEL=qwen/qwen3.8-omni-flash

# --- Браузерный парсинг (задает docker-compose, руками обычно не трогать) ---
# BROWSERLESS_URL=http://browser:3000
# BROWSERLESS_TOKEN=

# --- Сеть (только docker-compose) ---
# Куда биндить 8000 наружу. Нет переменной —> 127.0.0.1
# HOST_DOMAIN=0.0.0.0
